# renders, caches, scratch
videos/*/build/
media/
.cache/
__pycache__/
*.pyc
.venv/
.DS_Store
# Incubator: generated media is distributed through GitHub Releases.
outputs/
assets/fonts/
assets/tts-models/
release-staging/
references-private/
research/
.env
.env.*
!.env.example
*.local.json
*.local.md
.installation.json
# rendered videos are large: keep only the final cut in output/
videos/*/output/*_480p15.*
videos/*/output/*_720p30.*
videos/*/output/*/*_480p15.*
videos/*/output/*/*_720p30.*
# pilot excerpts (superseded by the full short): media stay local
videos/*/output/*/*_opening.mp4
videos/*/output/*/*_opening.*.mp4
videos/*/output/*/*_opening.music.wav
# partial burns (renamed when complete)
videos/*/output/*.partial.mp4
videos/*/output/*/*.partial.mp4
# shorts: the music-free copy and the score alone stay local (rebuild with --no-render); the masters are committed
videos/*-short/output/*.nomusic.mp4
videos/*-short/output/*.music.wav
# Rendered movies are release assets (docs/PUBLISHING.md), never tracked files; git keeps the
# recipe, subtitles, chapters and transcripts. Rebuild locally with --no-render, or download
# from the media release indexed in catalog/videos.json.
videos/*/output/*.mp4
videos/*/output/**/*.mp4

# Studio site data, built at deploy by tools/studio_status.py
site/data/
