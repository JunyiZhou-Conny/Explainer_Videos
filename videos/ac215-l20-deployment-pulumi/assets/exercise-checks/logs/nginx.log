## setup: network, two stand-ins, nginx with the repo nginx.conf
$ docker network create l20ex-net >/dev/null && echo network l20ex-net
network l20ex-net
[exit 0]

$ docker run -d --name l20ex-api --network l20ex-net --network-alias api-service -v <logs>/echo_stub.py:/stub.py:ro python:3.13-slim-bookworm python /stub.py api-service 9000 >/dev/null && echo l20ex-api started, alias api-service
l20ex-api started, alias api-service
[exit 0]

$ docker run -d --name l20ex-frontend --network l20ex-net --network-alias frontend -v <logs>/echo_stub.py:/stub.py:ro python:3.13-slim-bookworm python /stub.py frontend 3000 >/dev/null && echo l20ex-frontend started, alias frontend
l20ex-frontend started, alias frontend
[exit 0]

$ docker run -d --name l20ex-nginx --network l20ex-net -p 18080:80 -v <assets/source>/src/deployment/nginx-conf/nginx/nginx.conf:/etc/nginx/nginx.conf:ro nginx:stable >/dev/null && echo nginx started
nginx started
[exit 0]

