[exit 0]

$ docker rm -f l20ex-nginx >/dev/null; docker run -d --name l20ex-nginx --network l20ex-net -p 18080:80 -v <assets/source>/src/deployment/nginx-conf/nginx/nginx.conf:/etc/nginx/nginx.conf:ro nginx:stable >/dev/null && echo nginx started with the repo file again
