[exit 0]

$ curl -s http://localhost:18080/api-service/
{"container": "api-service", "path_seen": "/"}
[exit 0]

$ curl -s http://localhost:18080/api-service/status
{"container": "api-service", "path_seen": "/status"}
[exit 0]

$ curl -s http://localhost:18080/api-service/podcasts/?limit=3
