$ export GITHUB_OUTPUT=/tmp/out4; python3 /checks/runstep.py /checks/ci-exercises.yml test-summary slack-check > /tmp/s4.sh && cat /tmp/s4.sh && SLACK_WEBHOOK_URL= bash -eo pipefail /tmp/s4.sh && cat $GITHUB_OUTPUT
if [ -n "$SLACK_WEBHOOK_URL" ]; then
