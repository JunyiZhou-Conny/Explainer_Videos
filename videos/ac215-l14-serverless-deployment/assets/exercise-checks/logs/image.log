## B3: the job argv, as a plan (no API call, no upload)
$ docker run --rm --network none l14ex/translation-demo:local python -m translation_demo batch --plan --input-uri gs://YOUR_INPUT_BUCKET/run-001/passage.txt --src en --dest fr --output-uri gs://YOUR_OUTPUT_BUCKET/run-001/
{
  "status": "plan_only",
  "input_characters": null,
  "input_uri": "gs://YOUR_INPUT_BUCKET/run-001/passage.txt",
  "source_language": "en",
  "destination_language": "fr",
  "output_uri": "gs://YOUR_OUTPUT_BUCKET/run-001/",
  "steps": [
    "Read the passage",
    "Translate the complete passage",
    "Synthesize speech with Agent Platform",
    "Save text, audio, and completion manifest to a unique attempt prefix",
    "Exit"
  ],
  "implemented": true
}
[exit 0]

