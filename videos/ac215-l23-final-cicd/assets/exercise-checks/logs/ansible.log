$ cd /w && { printf -- '- hosts: localhost\n  connection: local\n  gather_facts: false\n  tasks:\n'; sed -n '101,118p' deploy-setup-containers.yml; } > tagbook.yml && cat .docker-tag && sed -n '1,5p;12,22p' tagbook.yml
20241121211313
- hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Set docker tag from environment if available
        - name: Read docker tag from file
          shell: "cat .docker-tag"
          register: tag_file
        - name: Set docker tag from file
          set_fact:
            docker_tag: "{{ tag_file.stdout }}"
      when: lookup('env', 'DOCKER_TAG') == ""

    - name: Debug final docker tag
      debug:
        msg: "Using docker tag: {{ docker_tag }}"
[exit 0]

