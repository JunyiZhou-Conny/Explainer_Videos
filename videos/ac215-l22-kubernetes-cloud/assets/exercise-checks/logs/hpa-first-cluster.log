# The B7 section of k8s.sh (the same script), as run at about 22:40 UTC on 2026-11-07 on the FIRST l22ex
# cluster, where metrics-server had already been applied once (a first B7 run there and one by-hand apply had
# shown the metrics API unavailable for minutes, then available). That cluster was deleted and re-created for
# the full run in k8s.log, where the metrics API stayed unavailable (403 from its discovery check) until the end.
## B7: a Pod autoscaler needs requests (metrics-server, v0.8.0, kubelet TLS check off for kind)
$ kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.8.0/components.yaml >/dev/null && kubectl -n kube-system patch deployment metrics-server --type=json -p '[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]' && kubectl -n kube-system rollout status deployment/metrics-server --timeout=240s
deployment.apps/metrics-server patched
deployment "metrics-server" successfully rolled out
[exit 0]

$ for i in $(seq 36); do kubectl top nodes >/dev/null 2>&1 && break; sleep 5; done; kubectl get apiservice v1beta1.metrics.k8s.io; kubectl top nodes
NAME                     SERVICE                      AVAILABLE   AGE
v1beta1.metrics.k8s.io   kube-system/metrics-server   True        64s
