# Vertex AI Configuration (Required)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Service Account Authentication (Recommended for production)
# Path to your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Gemini Model (Optional - defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# RAG Corpus (Set after running setup_corpus.py)
# Format: projects/{project}/locations/{location}/ragCorpora/{corpus_id}
RAG_CORPUS=
