# LiteLLM Multi-Model Configuration

# AWS OpenAI Configuration (Primary for this tutorial)
# Get from AWS console or https://platform.openai.com/api-keys
AWS_OPENAI_API_KEY=your_aws_openai_api_key_here

# Optional: Custom AWS OpenAI endpoint (if using AWS-hosted OpenAI)
# AWS_OPENAI_ENDPOINT=https://your-aws-openai-endpoint.com

# Google AI (Always supported)
GOOGLE_API_KEY=your_google_ai_api_key_here

# Optional: Standard OpenAI (non-AWS)
# OPENAI_API_KEY=your_openai_key_here

# Optional: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Model Selection
# Uncomment to override default model selection
# PRIMARY_MODEL=gpt-4
# FALLBACK_MODEL=gemini-2.0-flash
