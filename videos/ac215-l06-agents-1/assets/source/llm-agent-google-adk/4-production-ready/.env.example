# Google AI Configuration
GOOGLE_API_KEY=your_google_ai_api_key_here

# Google Cloud Configuration (for deployment)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Database Configuration
# Development: Use in-memory (no DATABASE_URL needed)
# Production: Use PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Application Configuration
APP_NAME=production-agent
PORT=8080
ENVIRONMENT=development  # or 'production'

# Security (generate strong random keys for production)
# API_SECRET_KEY=your-secret-key-here
# ALLOWED_ORIGINS=https://your-frontend.com,https://app.example.com

# Model Configuration
GEMINI_MODEL=gemini-2.0-flash

# Monitoring (optional)
# ENABLE_METRICS=true
# METRICS_PORT=9090
