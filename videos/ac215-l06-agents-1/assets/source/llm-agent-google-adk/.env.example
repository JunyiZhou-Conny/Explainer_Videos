# Root .env for running `adk web` from any tutorial folder

# Google AI Configuration (Required)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_api_key_here

# AWS OpenAI Configuration (for Tutorial 2)
# Get from: https://console.aws.amazon.com/ or https://platform.openai.com/api-keys
AWS_OPENAI_API_KEY=your_aws_openai_api_key_here

# Optional: Other LLM Providers
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Google Cloud (for production deployment - Tutorial 4)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Model Defaults
GEMINI_MODEL=gemini-2.5-flash
# AWS_OPENAI_MODEL=gpt-4

# Environment
ENVIRONMENT=development
